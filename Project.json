{
  "configs" : {
    "Debug" : "debug",
    "Release" : "release"
  },
  "name" : "Sure",
  "options" : {
    "deploymentTarget" : {
      "iOS" : "18.0",
      "macOS" : "15.0",
      "watchOS" : "11.0"
    },
    "groupSortPosition" : "bottom",
    "transitivelyLinkDependencies" : false
  },
  "packages" : {
    "PostHog" : {
      "url" : "https://github.com/PostHog/posthog-ios.git",
      "exactVersion" : "3.59.3"
    },
    "Sentry" : {
      "url" : "https://github.com/getsentry/sentry-cocoa.git",
      "exactVersion" : "9.29.2"
    }
  },
  "targets" : {
    "Sure" : {
      "configFiles" : {
        "Debug" : "Config/Debug.xcconfig",
        "Release" : "Config/Release.xcconfig"
      },
      "dependencies" : [
        {
          "package" : "PostHog",
          "destinationFilters" : ["iOS"]
        },
        {
          "package" : "Sentry",
          "destinationFilters" : ["iOS"]
        },
        {
          "destinationFilters" : [
            "iOS"
          ],
          "embed" : true,
          "target" : "Sure Watch"
        }
      ],
      "info" : {
        "path" : "App\/Info.plist",
        "properties" : {
          "SurePostHogProjectToken" : "$(SURE_POSTHOG_PROJECT_TOKEN)",
          "SurePostHogHost" : "$(SURE_POSTHOG_HOST)",
          "SureSentryDSN" : "$(SURE_SENTRY_DSN)",
          "SureFinanceKitKeychainAccessGroup" : "$(AppIdentifierPrefix)com.shifthuman.sure.financekit",
          "CFBundleDisplayName" : "Sure",
          "CFBundleShortVersionString" : "0.7.4",
          "CFBundleURLTypes" : [
            {
              "CFBundleTypeRole" : "Editor",
              "CFBundleURLName" : "com.shifthuman.sure.oauth",
              "CFBundleURLSchemes" : [
                "sureapp"
              ]
            }
          ],
          "CFBundleVersion" : "1",
          "ITSAppUsesNonExemptEncryption" : false,
          "NSFinancialDataUsageDescription" : "Sure uses financial data from Wallet for the on-device account preview and, only when you separately enable it, to sync selected accounts and transactions to your Sure family.",
          "LSApplicationCategoryType" : "public.app-category.finance",
          "UILaunchScreen" : {

          },
          "UISupportedInterfaceOrientations" : [
            "UIInterfaceOrientationPortrait",
            "UIInterfaceOrientationPortraitUpsideDown",
            "UIInterfaceOrientationLandscapeLeft",
            "UIInterfaceOrientationLandscapeRight"
          ]
        }
      },
      "platform" : "auto",
      "scheme" : {
        "postActions" : [
          {
            "name" : "Upload local iOS Debug symbols to Sentry",
            "script" : "\"${PROJECT_DIR}/.github/scripts/upload_local_sentry_symbols.sh\"",
            "settingsTarget" : "Sure"
          }
        ],
        "coverageTargets" : [
          "Sure"
        ],
        "gatherCoverageData" : true,
        "testTargets" : [
          "SureTests"
        ]
      },
      "settings" : {
        "base" : {
          "SURE_POSTHOG_HOST" : "https://us.i.posthog.com",
          "ASSETCATALOG_COMPILER_APPICON_NAME" : "AppIcon",
          "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME" : "AccentColor",
          "CODE_SIGN_ENTITLEMENTS[sdk=iphoneos*]" : "App\/iOS.entitlements",
          "CODE_SIGN_ENTITLEMENTS[sdk=iphonesimulator*]" : "App\/iOS.entitlements",
          "CODE_SIGN_ENTITLEMENTS[sdk=macosx*]" : "App\/macOS.entitlements",
          "SWIFT_ACTIVE_COMPILATION_CONDITIONS" : "$(inherited) SURE_SELF_HOSTED",
          "SWIFT_ACTIVE_COMPILATION_CONDITIONS[sdk=iphoneos*]" : "$(inherited) SURE_SELF_HOSTED",
          "SWIFT_ACTIVE_COMPILATION_CONDITIONS[sdk=iphonesimulator*]" : "$(inherited) SURE_SELF_HOSTED",
          "CURRENT_PROJECT_VERSION" : "1",
          "DEBUG_INFORMATION_FORMAT[sdk=iphoneos*]" : "dwarf-with-dsym",
          "MARKETING_VERSION" : "0.7.4",
          "PRODUCT_BUNDLE_IDENTIFIER" : "com.shifthuman.sure",
          "PRODUCT_NAME" : "$(TARGET_NAME)",
          "SWIFT_VERSION" : "5.0",
          "TARGETED_DEVICE_FAMILY" : "1,2"
        },
        "configs" : {
          "Release" : {
            "CODE_SIGN_STYLE" : "Automatic",
            "CODE_SIGN_STYLE[sdk=iphoneos*]" : "Manual",
            "CODE_SIGN_IDENTITY[sdk=iphoneos*]" : "Apple Distribution",
            "DEVELOPMENT_TEAM[sdk=iphoneos*]" : "3ELWNV29J2",
            "PROVISIONING_PROFILE_SPECIFIER[sdk=iphoneos*]" : "Sure App Store"
          }
        }
      },
      "sources" : [
        {
          "path" : "App"
        },
        {
          "path" : "Shared"
        }
      ],
      "supportedDestinations" : [
        "iOS",
        "macOS"
      ],
      "type" : "application"
    },
    "SureTests" : {
      "dependencies" : [
        {
          "target" : "Sure"
        }
      ],
      "platform" : "auto",
      "settings" : {
        "base" : {
          "BUNDLE_LOADER" : "$(TEST_HOST)",
          "SWIFT_VERSION" : "5.0",
          "TEST_HOST[sdk=iphoneos*]" : "$(BUILT_PRODUCTS_DIR)\/Sure.app\/Sure",
          "TEST_HOST[sdk=iphonesimulator*]" : "$(BUILT_PRODUCTS_DIR)\/Sure.app\/Sure",
          "TEST_HOST[sdk=macosx*]" : "$(BUILT_PRODUCTS_DIR)\/Sure.app\/Contents\/MacOS\/Sure"
        }
      },
      "sources" : [
        {
          "path" : "Tests\/SureTests"
        }
      ],
      "supportedDestinations" : [
        "iOS",
        "macOS"
      ],
      "type" : "bundle.unit-test"
    },
    "Sure Watch" : {
      "info" : {
        "path" : "Watch\/Info.plist",
        "properties" : {
          "CFBundleDisplayName" : "Sure",
          "CFBundleShortVersionString" : "0.7.4",
          "CFBundleVersion" : "1",
          "ITSAppUsesNonExemptEncryption" : false,
          "WKApplication" : true,
          "WKCompanionAppBundleIdentifier" : "com.shifthuman.sure"
        }
      },
      "platform" : "watchOS",
      "scheme" : {
        "coverageTargets" : [
          "Sure Watch"
        ],
        "gatherCoverageData" : true,
        "testTargets" : [
          "Sure WatchTests"
        ]
      },
      "settings" : {
        "base" : {
          "ASSETCATALOG_COMPILER_APPICON_NAME" : "AppIcon",
          "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME" : "AccentColor",
          "CURRENT_PROJECT_VERSION" : "1",
          "MARKETING_VERSION" : "0.7.4",
          "PRODUCT_BUNDLE_IDENTIFIER" : "com.shifthuman.sure.watchkitapp",
          "PRODUCT_NAME" : "$(TARGET_NAME)",
          "SWIFT_VERSION" : "5.0"
        },
        "configs" : {
          "Release" : {
            "CODE_SIGN_STYLE" : "Automatic",
            "CODE_SIGN_STYLE[sdk=watchos*]" : "Manual",
            "CODE_SIGN_IDENTITY[sdk=watchos*]" : "Apple Distribution",
            "DEVELOPMENT_TEAM[sdk=watchos*]" : "3ELWNV29J2",
            "PROVISIONING_PROFILE_SPECIFIER[sdk=watchos*]" : "Sure Watch App Store"
          }
        }
      },
      "sources" : [
        {
          "path" : "Watch"
        },
        {
          "path" : "Shared"
        },
        {
          "path" : "App\/Assets.xcassets"
        }
      ],
      "type" : "application"
    },
    "Sure WatchTests" : {
      "dependencies" : [
        {
          "target" : "Sure Watch"
        }
      ],
      "platform" : "watchOS",
      "settings" : {
        "base" : {
          "SWIFT_VERSION" : "5.0"
        }
      },
      "sources" : [
        {
          "path" : "Tests\/SureWatchTests"
        }
      ],
      "type" : "bundle.unit-test"
    },
    "Sure UI Host": {
      "type": "application",
      "platform": "iOS",
      "sources": [
        {
          "path": "App",
          "excludes": [
            "Application/AppDefinition.swift",
            "Info.plist"
          ]
        },
        {
          "path": "Shared"
        },
        {
          "path": "Tests/SureUITestHost"
        }
      ],
      "dependencies": [
        {
          "package": "PostHog"
        },
        {
          "package": "Sentry"
        }
      ],
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "com.shifthuman.sure.uitest-host",
          "SWIFT_ACTIVE_COMPILATION_CONDITIONS": "$(inherited)",
          "GENERATE_INFOPLIST_FILE": "YES",
          "SWIFT_VERSION": "5.0",
          "TARGETED_DEVICE_FAMILY": "1,2",
          "INFOPLIST_KEY_UILaunchScreen_Generation": "YES"
        }
      },
      "scheme": {
        "testTargets": [
          "Sure UI Tests"
        ]
      }
    },
    "Sure UI Tests": {
      "type": "bundle.ui-testing",
      "platform": "iOS",
      "sources": [
        {
          "path": "Tests/SureUITests"
        }
      ],
      "dependencies": [
        {
          "target": "Sure UI Host"
        }
      ],
      "settings": {
        "base": {
          "TEST_TARGET_NAME": "Sure UI Host",
          "SWIFT_VERSION": "5.0",
          "GENERATE_INFOPLIST_FILE": "YES"
        }
      }
    }
  }
}
